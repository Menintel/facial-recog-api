# backend/services/deepface-service/Dockerfile.gpu
# Base image for CUDA - adjust based on your CUDA/cudNN version
FROM nvidia/cuda:11.7.1-cudnn8-runtime-ubuntu20.04

WORKDIR /app

# Install Python and pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    # Additional libraries for OpenCV and general utilities
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Optional: install build tools if you compile dlib or other libs
    # build-essential \
    # cmake \
    && rm -rf /var/lib/apt/lists/*

RUN alias python=python3 && alias pip=pip3


# Install GPU-specific requirements
COPY requirements-gpu.txt .
RUN pip3 install --no-cache-dir -r requirements-gpu.txt

COPY src/ ./src/
COPY models/ ./models/ 
# If you pre-download models

ENV DEEPFACE_HOME=/app/models/.deepface

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
# For GPU, typically --workers 1 as GPU resources are managed differently